#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUTPUT_DIR="$ROOT_DIR/output"
GRUB4DOS_DIR="$ROOT_DIR/grub4dos"
ISO_LABEL="${ISO_LABEL:-MINIGG_BOOT}"
TMP_DIR=

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: script/make_bootable_iso [kernel_path] [initramfs_path]

Default behavior:
  - load the highest-version non-mod kernel from output/<version>/bzImage
  - load the newest initramfs from output/initrd-*.zst
  - build missing grub4dos legacy and EFI artifacts via grub4dos/Makefile
  - write the final ISO to output/bootable-YYYYMMDD-HHMMSS.iso

Requirements:
  make, xorriso, and the grub4dos project build tools
EOF
}

cleanup() {
  if [ -n "${TMP_DIR:-}" ] && [ -d "$TMP_DIR" ]; then
    rm -rf -- "$TMP_DIR"
  fi
}

require_command() {
  local command_name=$1

  command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name"
}

require_file() {
  local path=$1
  local description=$2

  [ -f "$path" ] || die "$description not found: $path"
}

require_dir() {
  local path=$1
  local description=$2

  [ -d "$path" ] || die "$description not found: $path"
}

find_latest_standard_kernel() {
  local candidate_path
  local legacy_version

  candidate_path="$(
    find "$OUTPUT_DIR" -mindepth 2 -maxdepth 2 -type f -path '*/bzImage' -printf '%P\n' 2>/dev/null \
      | sed -n '/-mod\/bzImage$/d; p' \
      | sort -V \
      | tail -n 1
  )"

  if [ -n "$candidate_path" ]; then
    printf '%s\n' "$OUTPUT_DIR/$candidate_path"
    return 0
  fi

  legacy_version="$(
    find "$OUTPUT_DIR" -maxdepth 1 -type f -name 'bzImage_*' -printf '%f\n' 2>/dev/null \
      | sed -n '/-mod$/d; s/^bzImage_//p' \
      | sort -V \
      | tail -n 1
  )"

  [ -n "$legacy_version" ] || return 1
  printf '%s\n' "$OUTPUT_DIR/bzImage_$legacy_version"
}

find_latest_initrd() {
  local path

  path="$(
    find "$OUTPUT_DIR" -maxdepth 1 -type f -name 'initrd-*' -printf '%T@ %p\n' 2>/dev/null \
      | sort -n \
      | tail -n 1 \
      | cut -d' ' -f2-
  )"

  [ -n "$path" ] || return 1
  printf '%s\n' "$path"
}

next_output_path() {
  local timestamp output_path

  while :; do
    timestamp="$(date +%Y%m%d-%H%M%S)"
    output_path="$OUTPUT_DIR/bootable-$timestamp.iso"
    if [ ! -e "$output_path" ]; then
      printf '%s\n' "$output_path"
      return 0
    fi
    sleep 1
  done
}

write_menu() {
  local menu_path=$1

  mkdir -p "$(dirname "$menu_path")"
  cat >"$menu_path" <<'EOF'
default 0
timeout 0
debug off

title Boot Ubuntu LiveOS
	find --set-root /bzImage
	kernel /bzImage
	initrd /initrd.zst

title Reboot
	reboot

title Shutdown
	halt
EOF
}

ensure_grub4dos_artifacts() {
  local grldr="$GRUB4DOS_DIR/artifacts/0.4.6a/grldr"
  local efisys="$GRUB4DOS_DIR/artifacts/efi/efisys.bin"

  require_dir "$GRUB4DOS_DIR" "grub4dos project directory"
  require_file "$GRUB4DOS_DIR/Makefile" "grub4dos project Makefile"
  require_command make

  make -C "$GRUB4DOS_DIR" check-tools

  if [ ! -f "$grldr" ] || [ ! -f "$efisys" ]; then
    make -C "$GRUB4DOS_DIR" both
  fi

  require_file "$grldr" "grub4dos BIOS loader"
  require_file "$efisys" "EFI boot image"
}

build_iso() {
  local kernel_path=$1
  local initrd_path=$2
  local output_iso=$3
  local iso_root

  ensure_grub4dos_artifacts

  TMP_DIR="$(mktemp -d "$OUTPUT_DIR/.bootable-iso.XXXXXX")"
  iso_root="$TMP_DIR/iso_root"

  mkdir -p "$iso_root"
  cp "$kernel_path" "$iso_root/bzImage"
  cp "$initrd_path" "$iso_root/initrd.zst"
  write_menu "$iso_root/efi/grub/menu.lst"

  make -C "$GRUB4DOS_DIR" iso-only \
    ISO_ROOT="$iso_root" \
    ISO_OUT="$output_iso" \
    ISO_LABEL="$ISO_LABEL"
}

if [ $# -gt 2 ]; then
  usage >&2
  exit 1
fi

if [ $# -ge 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  [ $# -eq 1 ] || die "--help does not accept additional arguments"
  usage
  exit 0
fi

trap cleanup EXIT

mkdir -p "$OUTPUT_DIR"

KERNEL_PATH="${1:-}"
INITRD_PATH="${2:-}"

if [ -z "$KERNEL_PATH" ]; then
  KERNEL_PATH="$(find_latest_standard_kernel)" || die "no non-mod kernel image found under $OUTPUT_DIR"
fi

if [ -z "$INITRD_PATH" ]; then
  INITRD_PATH="$(find_latest_initrd)" || die "no initramfs image found under $OUTPUT_DIR"
fi

require_file "$KERNEL_PATH" "kernel image"
require_file "$INITRD_PATH" "initramfs image"

OUTPUT_ISO="$(next_output_path)"
build_iso "$KERNEL_PATH" "$INITRD_PATH" "$OUTPUT_ISO"

printf 'Kernel : %s\n' "$KERNEL_PATH"
printf 'Initrd : %s\n' "$INITRD_PATH"
printf 'Source : %s\n' "$GRUB4DOS_DIR"
printf 'ISO    : %s\n' "$OUTPUT_ISO"
